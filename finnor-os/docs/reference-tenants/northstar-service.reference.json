{
  "manifestVersion": 2,
  "clientKey": "reference-northstar-service",
  "tenant": {
    "name": "Northstar Service (Reference)",
    "timezone": "America/Chicago",
    "settings": { "isDealerZero": false, "simulatorEnabled": false, "trainingMode": true }
  },
  "users": [
    { "email": "owner@northstar.example", "role": "owner", "displayName": "Reference Owner" },
    { "email": "dispatch@northstar.example", "role": "dispatcher", "displayName": "Reference Dispatcher" },
    { "email": "field@northstar.example", "role": "technician", "displayName": "Reference Technician" }
  ],
  "workspaceConfig": {
    "version": 2,
    "enabledSurfaces": ["home", "work", "customers", "schedule", "money", "agents"],
    "terminology": { "home": "Command", "work": "Service Work", "customers": "Households", "schedule": "Dispatch", "money": "Cash", "agents": "Automation" },
    "vocabulary": { "customer": "Household", "homeowner": "Homeowner", "account": "Service Account", "technician": "Field Technician", "installer": "Installer", "serviceVisit": "Service Call", "appointment": "Appointment", "quote": "Estimate", "proposal": "Proposal", "invoice": "Invoice", "job": "Service Job", "work": "Work" },
    "voiceEnabled": true,
    "navigationPriority": ["home", "schedule", "work", "customers", "money", "agents"],
    "brand": { "accent": "teal", "surfaceTone": "slate", "radius": "precise", "density": "compact", "typography": "technical", "motion": "restrained", "mark": "NS", "logoAssetKey": "reference-northstar" },
    "visibility": { "policy": true, "authority": true },
    "roles": {
      "owner": { "startView": "command", "visibleSurfaces": ["home", "work", "customers", "schedule", "money", "agents"], "ready": { "primaryFocus": "service", "heroMetric": "overdue_invoice_value", "pulseMetrics": ["overdue_invoice_value", "pending_approvals", "technician_load", "runs_in_flight"], "attentionCategories": ["recovery", "approval", "schedule", "money", "customer", "work"], "quickActions": [{ "key": "review_schedule", "label": "Review service calls" }, { "key": "review_overdue_invoices" }, { "key": "review_pending_approvals" }], "primaryProjection": "schedule" } },
      "dispatcher": { "startView": "schedule", "visibleSurfaces": ["home", "work", "customers", "schedule", "agents"], "ready": { "primaryFocus": "dispatch", "heroMetric": "technician_load", "pulseMetrics": ["technician_load", "pending_approvals", "runs_in_flight", "stuck_runs"], "attentionCategories": ["recovery", "approval", "schedule", "customer", "work"], "quickActions": [{ "key": "review_schedule", "label": "Open today’s field" }, { "key": "review_technician_load" }, { "key": "review_pending_approvals" }], "primaryProjection": "schedule" } },
      "technician": { "startView": "my-day", "visibleSurfaces": ["home", "work", "customers", "schedule"], "ready": { "primaryFocus": "assigned_work", "heroMetric": "assigned_work_today", "pulseMetrics": ["assigned_work_today"], "attentionCategories": ["recovery", "schedule", "customer", "work"], "quickActions": [{ "key": "open_my_day", "label": "Open assigned calls" }], "primaryProjection": "assigned-day" } }
    },
    "scenes": {
      "ready": { "detail": "compact", "emphasis": "presence" }, "listening": { "detail": "compact", "emphasis": "presence" }, "plan": { "detail": "compact", "emphasis": "context" }, "approval": { "detail": "detailed", "emphasis": "evidence" }, "working": { "detail": "compact", "emphasis": "evidence" }, "outcome": { "detail": "balanced", "emphasis": "evidence" }, "recovery": { "detail": "detailed", "emphasis": "context" }
    },
    "extensions": {
      "ready.primary": { "key": "reference.northstar-service-priority", "config": { "title": "Service response priorities", "emphasis": "response" } },
      "role.dispatcher": { "key": "reference.northstar-service-priority", "config": { "title": "Field continuity", "emphasis": "retention" } }
    }
  }
}
