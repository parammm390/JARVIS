{
  "schemaVersion": 1,
  "package": "@finnor/trace-compiler",
  "mode": "PURE_OFFLINE_NON_EXECUTING",
  "traceIr": {
    "root": "ExecutionTrace",
    "node": "TraceNode",
    "edge": "TraceEdge",
    "edgeKinds": ["CONTROL", "DATA", "CAUSAL", "OBSERVATION", "AUTHORITY", "RETRY", "COMPENSATION", "TEMPORAL"],
    "outcomes": ["SUCCESS", "PARTIAL_SUCCESS", "RECOVERED_SUCCESS", "FAILURE", "AMBIGUOUS", "CORRUPT", "INCOMPLETE"],
    "evidenceClasses": ["REAL_EXECUTION", "SIMULATED_EXECUTION", "REPLAY_FIXTURE"]
  },
  "identity": {
    "tracePrefix": "p6:trace:sha256:",
    "alignmentPrefix": "p6:alignment:sha256:",
    "candidatePrefix": "p6:candidate:sha256:",
    "distinctFrom": ["Work ID", "BusinessEffect semanticHash", "provider operation ID", "idempotency key", "Operational IR semantic hash", "P5 simulation trace ID"],
    "sourceMappingsRetainedIn": "tenant-bound ExecutionTrace.provenance.sourceIdentities",
    "procedureCandidateIdentityReferences": "domain-separated opaque hashes only"
  },
  "normalization": {
    "redactionBeforeIdentity": true,
    "causalOrderingPreserved": true,
    "uncertaintyPreserved": true,
    "failureAttemptsPreserved": true,
    "providerAckIsVerifiedSuccess": false,
    "replacementLedger": false
  },
  "dataflow": {
    "roles": ["SOURCE", "PARAMETER", "CONSTANT", "DERIVED", "LOOKUP_RESULT", "EXTERNAL_OBSERVATION", "MODEL_DECISION", "USER_INPUT", "RUNTIME_GENERATED"],
    "bindingInference": ["EXPLICIT_BINDING", "SAME_TENANT_EXACT_EQUALITY_TOKEN"],
    "fuzzySimilarityBinding": false,
    "derivedValueRequiresProvenance": true
  },
  "alignment": {
    "algorithm": "DETERMINISTIC_SEMANTIC_GRAPH_ALIGNMENT",
    "features": ["operation equivalence class", "effect class", "typed input/output interface", "authority/observation/consequence boundary", "dataflow neighborhood"],
    "arrayPositionOnly": false,
    "outputs": ["alignment groups", "unmatched nodes", "safety-boundary mismatches"]
  },
  "antiUnification": {
    "algorithm": "CONSERVATIVE_LEAST_GENERAL_SUPPORTED_GRAPH",
    "positiveBodySource": "positive real traces, or explicitly unsupported replay/simulated fallback when no positive real trace exists",
    "negativeOnlyActionsEnterPositiveBody": false,
    "safetyCriticalDifferencesCollapsed": false,
    "stableOrderingAndTieBreaking": true
  },
  "candidate": {
    "artifact": "ProcedureCandidate",
    "executionStatus": "NON_EXECUTABLE_HYPOTHESIS",
    "certificationStatus": "UNCERTIFIED_P6_HYPOTHESIS",
    "automaticPlannerInput": false,
    "frozen": true,
    "authorityGrantPossible": false
  }
}
